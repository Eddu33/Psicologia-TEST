generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  password          String
  name              String
  role              String   @default("PROFESSIONAL") // "ADMIN" | "ADMISIONISTA" | "PROFESSIONAL"
  
  // Horarios de atención
  morningShiftStart String?  // "HH:mm" (ej. "08:00")
  morningShiftEnd   String?  // "HH:mm" (ej. "12:00")
  afternoonShiftStart String? // "HH:mm" (ej. "14:00")
  afternoonShiftEnd String?  // "HH:mm" (ej. "18:00")
  
  appointments      Appointment[]
  observations      ProfessionalObservation[]
  licenses          License[]
  auditLogs         AuditLog[]
  
  ownedNotes        Note[]    @relation("OwnedNotes")
  sharedNotes       Note[]    @relation("SharedNotes")
}

model Patient {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  dni         String   @unique
  age         Int
  phone       String
  adminNotes  String?  
  createdAt   DateTime @default(now())
  
  appointments Appointment[]
  observations ProfessionalObservation[]
}

model Appointment {
  id             String   @id @default(uuid())
  date           String   // "YYYY-MM-DD"
  startTime      String   // "HH:mm"
  endTime        String   // "HH:mm"
  
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  
  professionalId String?  
  professional   User?    @relation(fields: [professionalId], references: [id])
  
  status         String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED_BY_LIC, ABSENT, COMPLETED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  observations   ProfessionalObservation[]
}

model ProfessionalObservation {
  id             String   @id @default(uuid())
  
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  
  professionalId String
  professional   User     @relation(fields: [professionalId], references: [id])
  
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  
  observation    String
  
  createdAt      DateTime @default(now())
}

model License {
  id             String   @id @default(uuid())
  professionalId String
  professional   User     @relation(fields: [professionalId], references: [id])
  
  startDate      String   // "YYYY-MM-DD"
  endDate        String   // "YYYY-MM-DD"
  reason         String?
  
  createdAt      DateTime @default(now())
}

model Holiday {
  id             String   @id @default(uuid())
  date           String   @unique // "YYYY-MM-DD"
  description    String
  
  createdAt      DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // ej. "CREAR_PACIENTE", "REAGENDAR_TURNO"
  entityType  String   // ej. "PATIENT", "APPOINTMENT", "USER"
  entityId    String   // ID de la entidad afectada
  details     String   // Detalles de la modificación
  
  userId      String?  // Quién realizó la acción
  user        User?    @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  color     String   @default("yellow")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  ownerId   String
  owner     User     @relation("OwnedNotes", fields: [ownerId], references: [id])
  
  sharedWith User[]  @relation("SharedNotes")
}
